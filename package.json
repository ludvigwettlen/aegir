{
  "name": "aegir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --mac dir",
    "check": "tsc -b",
    "test": "vitest run",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@playwright/mcp": "0.0.82",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@usefragments/ui": "^3.1.2",
    "better-sqlite3": "^12.2.0",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.468.0",
    "playwright": "1.64.0-alpha-1789764292000",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "sass": "^1.104.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "dev.personal.aegir",
    "productName": "Aegir",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    }
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
