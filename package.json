{
  "name": "aegir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --mac dir",
    "check": "tsc -b",
    "test": "vitest run",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@usefragments/ui": "^3.1.2",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "sass": "^1.104.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "dev.personal.aegir",
    "productName": "Aegir",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-light.png"
    }
  }
}
